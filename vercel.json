{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "dist/vercel.js",
      "framework": "express",
      "includeFiles": ["node_modules/**"]
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/signup",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/auth/login",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/auth/refresh",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/admin/(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/profile/(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/workspaces",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/workspaces/(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/data/(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/notes/(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/daily/(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/ai/general/(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/api/health",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "type": "service", "service": "frontend" }
    }
  ]
}
