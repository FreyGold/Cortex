{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/(.*)",
      "destination": "https://cortex-api-nu.vercel.app/api/admin/$1"
    },
    {
      "source": "/api/profile/(.*)",
      "destination": "https://cortex-api-nu.vercel.app/api/profile/$1"
    },
    {
      "source": "/api/workspaces",
      "destination": "https://cortex-api-nu.vercel.app/api/workspaces"
    },
    {
      "source": "/api/workspaces/(.*)",
      "destination": "https://cortex-api-nu.vercel.app/api/workspaces/$1"
    },
    {
      "source": "/api/data/(.*)",
      "destination": "https://cortex-api-nu.vercel.app/api/data/$1"
    },
    {
      "source": "/api/notes/(.*)",
      "destination": "https://cortex-api-nu.vercel.app/api/notes/$1"
    },
    {
      "source": "/api/daily/(.*)",
      "destination": "https://cortex-api-nu.vercel.app/api/daily/$1"
    },
    {
      "source": "/api/daily",
      "destination": "https://cortex-api-nu.vercel.app/api/daily"
    },
    {
      "source": "/api/ai/general/(.*)",
      "destination": "https://cortex-api-nu.vercel.app/api/ai/general/$1"
    },
    {
      "source": "/api/health",
      "destination": "https://cortex-api-nu.vercel.app/api/health"
    },
    {
      "source": "/(.*)",
      "destination": { "type": "service", "service": "frontend" }
    }
  ]
}
