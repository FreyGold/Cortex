PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Neon configuration. Set all five required values together.
NEON_AUTH_BASE_URL=
# Append /.well-known/jwks.json to the Auth base URL.
NEON_AUTH_JWKS_URL=
# Use the Auth URL origin for the issuer and audience.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
NEON_DATA_API_URL=
